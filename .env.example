# Google Search Console verification token: the content="..." of its HTML tag.
# Set it in Vercel for Production only; the tag is left out of other builds.
NEXT_PUBLIC_GSC_VERIFICATION=

# Development only: stop the clock at this moment (ISO date) to check the
# race weekend states on Home, e.g. 2026-10-10T15:00Z. Ignored in production.
NEXT_PUBLIC_FAKE_NOW=
